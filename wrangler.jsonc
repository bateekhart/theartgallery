// Cloudflare Worker that serves this folder as a static site.
// "name" must match the Worker in the Cloudflare dashboard.
// worker/index.js adds per-page share previews, http→https + www redirects and /sitemap.xml.
// Deploy with `npx wrangler deploy` from a copy of this folder (see CLAUDE.md).
{
  "name": "theartgallery1",
  "compatibility_date": "2026-10-13",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "theartgallery.world", "custom_domain": true },
    { "pattern": "www.theartgallery.world", "custom_domain": true }
  ]
}
